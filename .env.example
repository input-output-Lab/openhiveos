# OpenHiveOS — environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/openhiveos

# Google Gemini API key — used for embeddings (gemini-embedding-001, 768-dim)
GEMINI_API_KEY=your-gemini-api-key-here

# Process-level agent identity — ARCH-008 Decision 7
# Format: <32-hex-salt>.<64-hex-secret>  (97 chars total, 256-bit entropy)
# Generate with: npx tsx scripts/provision-agent-token.ts <agent-slug>
# Store securely — the plaintext secret cannot be recovered from the database.
AGENT_TOKEN=<run scripts/provision-agent-token.ts to generate>

# HTTP port for GET /health (Docker health probe — separate from MCP stdio transport)
# Optional — defaults to 3000
# OpenHiveOS — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://openhiveos:change-me@localhost:5432/openhiveos

# Google Gemini API key — used for memory and thought embeddings
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# Password for the openhiveos PostgreSQL user (used by docker-compose.yml migrate service)
# Must match the password portion of DATABASE_URL above.
# The migrate service (superuser) uses this to bootstrap the database and run DDL migrations.
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# SEC-7 — Database credential isolation (migration 007_db_roles_sec7.sql)
# ---------------------------------------------------------------------------

# Password for the opensquad_app runtime database user (DML only, no DDL).
# All runtime services (mcp, squad-api, gateway) connect as opensquad_app.
# Must DIFFER from POSTGRES_PASSWORD — credential-level isolation (SEC-7).
#
# OPERATOR ACTION REQUIRED after applying migration 007:
#   psql -U openhiveos -d openhiveos -c "ALTER ROLE opensquad_app PASSWORD '<value>';"
# Then set APP_PASSWORD= to the same value here.
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port for the HTTP health endpoint (default: 3000)
# GET http://localhost:$HEALTH_PORT returns {"status":"ok",...}
HEALTH_PORT=3000

# ---------------------------------------------------------------------------
# Ethos Seal — ARCH-013
# ---------------------------------------------------------------------------

# HMAC-SHA256 signing key for the Ethos Seal (v0.2 interim — Ed25519 required by v0.3).
# Must be exactly 64 hex characters (256-bit CSPRNG). Unique per Squad. Never reused.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED at provisioning time (scripts/one-init.ts). NOT read by the MCP server at runtime.
ETHOS_SEAL_SECRET=

# Absolute path for the exported Ethos Seal file (ethos.seal.json).
# The MCP server reads this file at boot for integrity verification.
# Must be bind-mounted into the container at this path.
# Default: ./ethos.seal.json
ETHOS_SEAL_PATH=./ethos.seal.json

# Docker Compose only — host directory that is bind-mounted into init-profile
# services (one-init, provision) so the seal file persists on the host after
# the container exits. Must be an absolute path in production.
# Example: ETHOS_SEAL_DIR=/etc/openhiveos/seal
ETHOS_SEAL_DIR=./ethos-seal

# ---------------------------------------------------------------------------
# Squad API (ARCH-012) — port 3005
# ---------------------------------------------------------------------------

# Port the squad-api HTTP service listens on (default: 3005).
# Must match VITE_SQUAD_API_URL in packages/dashboard/ build config.
# Port change requires dashboard image rebuild — communicate to Cooper.
SQUAD_API_PORT=3005

# Bind address for the squad-api (default: 127.0.0.1 — loopback only, SEC-A3).
# Set to 0.0.0.0 ONLY when behind a reverse proxy with TLS termination.
# SQUAD_API_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Agent Onboarding (ARCH-014) — batch provisioning
# ---------------------------------------------------------------------------

# Required by scripts/provision-all-agents.ts (SEC-C4: path traversal prevention).
# Only paths under this directory are accepted as --write-env targets.
# The token file is written with chmod 600. Never set this to a world-readable
# directory (e.g. /tmp). Recommended: /run/secrets or a dedicated secrets volume.
# Example: PROVISION_ENV_DIR=/run/secrets
PROVISION_ENV_DIR=

# ---------------------------------------------------------------------------
# LLM Usage Tracking (ARCH-015) — Bridge ingestion
# ---------------------------------------------------------------------------

# Scoped bearer token for POST /internal/usage on the squad-api.
# Bridge presents this token to authenticate ingestion requests.
# NOT an agent token — separate auth path (SEC-C8 scope boundary).
#
# Must be exactly 64 hex characters (32 bytes CSPRNG entropy — SEC-C1).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in .env AND 1Password. Never commit a real value.
# Rotation: generate new → update Bridge env → restart Bridge →
#           update this file → restart squad-api → old token invalidated.
OPENHIVEOS_INGESTION_TOKEN=

# URL that Bridge uses to reach the squad-api ingestion endpoint.
# Example: http://squad-api:3005  (Docker internal network, no trailing slash)
# Example: https://api.yourdomain.com  (reverse proxy with TLS)
# Bridge POSTs to: $OPENHIVEOS_INGESTION_URL/internal/usage
OPENHIVEOS_INGESTION_URL=

# ---------------------------------------------------------------------------
# MCP Gateway (ARCH-016) — integration Compose profile
#
# Stage 6 of canonical operator onboarding.
# Run with: docker compose --profile integration up -d openhiveos-mcp-gateway
# ---------------------------------------------------------------------------

# Authentication token for the mcp-gateway SSE endpoint (SEC-D1, SEC-D2).
# Any connecting Bridge must pass this as ?token=<value> in the SSE URL.
# Must be exactly 64 lowercase hex characters (32 bytes CSPRNG entropy).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in .env AND 1Password. Never commit a real value.
# Rotation: generate new → update Bridge env → restart Bridge → restart gateway → old token invalidated.
MCP_GATEWAY_TOKEN=

# Internal SSE port for the mcp-gateway (SEC-D4 — loopback binding, default: 3006).
# Exposed to the host at 127.0.0.1:${MCP_GATEWAY_PORT}. Never 0.0.0.0.
# Multi-instance hosts MUST use distinct ports per Squad Instance.
MCP_GATEWAY_PORT=3006

# URL the Bridge uses to reach the mcp-gateway SSE endpoint.
# Topology A (PM2 or systemd consumer on the same host — loopback):
#   MCP_GATEWAY_URL=http://127.0.0.1:3006
# Topology B (Compose co-deployed consumer via internal DNS):
#   MCP_GATEWAY_URL=http://openhiveos-mcp-gateway:3006
MCP_GATEWAY_URL=http://127.0.0.1:3006

# Health port for the mcp-gateway's MCP subprocess (SEC-D7).
# Must differ from the standalone mcp container HEALTH_PORT (default: 3000).
# Default: 3007 — do not collide with the standalone mcp container.
GATEWAY_HEALTH_PORT=3007
