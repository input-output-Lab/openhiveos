# OpenHiveOS Dashboard — Environment Variables
#
# Copy to .env.local for local development. Never commit .env.local.
#
# ── Required ─────────────────────────────────────────────────────────────────
#
# Bearer token for the dashboard agent principal.
# Provisioned via: npx tsx scripts/provision-agent-token.ts dashboard
# This token is baked into the Vite build at compile time.
# Token rotation requires a dashboard rebuild + redeploy.
VITE_DASHBOARD_AGENT_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────
#
# Override squad-api base URL for cross-origin access.
# Leave empty in development (Vite proxy handles /api/* → localhost:3005).
# Leave empty in production (same-origin via express.static in squad-api).
VITE_SQUAD_API_URL=
