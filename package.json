{
  "name": "openhiveos",
  "version": "0.2.0",
  "description": "OpenHiveOS — the open operating system for AI agent teams",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:all": "tsc && npm run dashboard:build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "agents:check": "tsx scripts/check-agent-protocol.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dashboard:dev": "cd packages/dashboard && npm run dev",
    "dashboard:build": "cd packages/dashboard && npm run build",
    "dashboard:typecheck": "cd packages/dashboard && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:install": "bats tests/install/install.bats",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "gray-matter": "^4.0.3",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "proxy-addr": "2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "bats": "^1.13.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  }
}
